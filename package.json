{
    "name": "@tongleem/tcad-sde",
    "version": "0.1.0",
    "description": "A TS package to generate Sentaurus SDE script.",
    "keywords": [
        "TCAD",
        "code-generate"
    ],
    "author": "tongleen",
    "license": "Apache-2.0",
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@types/node": "^26.6.2",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "./dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build",
        "format": "biome format --write ."
    }
}
